FROM eclipse-temurin:17-jre-alpine

RUN addgroup -S recon && adduser -S recon -G recon
WORKDIR /opt/recon

COPY target/reconciliation-platform-*.jar app.jar

ENV APP_ROLE=producer
USER recon
EXPOSE 8080

ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-XX:+ExitOnOutOfMemoryError", "-jar", "/opt/recon/app.jar"]


