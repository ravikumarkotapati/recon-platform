        <mxCell id="p1" value="1. Producer Scheduler&#xa;Configurable TPS&#xa;Backpressure guard checks RECON.IN depth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#0747A6;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="230" width="230" height="125" as="geometry"/></mxCell>
