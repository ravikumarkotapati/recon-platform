        <mxCell id="ns2" value="Namespace: observability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FCFF;strokeColor=#00A3BF;fontSize=16;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1190" y="180" width="380" height="650" as="geometry"/></mxCell>
        <mxCell id="deploy1" value="Deployment&#xa;recon-producer-app&#xa;replicas: 1..3 HPA&#xa;liveness/readiness probes&#xa;rolling update maxUnavailable=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#0747A6;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="180" y="265" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="deploy2" value="Deployment&#xa;recon-consumer-app&#xa;replicas: 1..4 HPA&#xa;controlled concurrency&#xa;bulkhead isolation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#00875A;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="470" y="265" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="deploy3" value="Deployment&#xa;recon-dashboard-api&#xa;LoadBalancer service&#xa;health endpoints&#xa;status / failed / queue / replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#6B778C;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="265" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="sts" value="StatefulSet&#xa;ibm-mq-0&#xa;QM1 data on PVC&#xa;gp3 StorageClass&#xa;MQSC ConfigMap mounts queues" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF0B3;strokeColor=#FFAB00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="500" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="cfg" value="ConfigMaps&#xa;Runtime configuration&#xa;MQ topology scripts&#xa;Grafana dashboards&#xa;Prometheus rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="470" y="500" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="sa" value="ServiceAccount recon-app-sa&#xa;IRSA annotation&#xa;AWS_ROLE_ARN injected&#xa;Web identity token volume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#DE350B;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="500" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="hpa" value="HPA / PDB / Probes&#xa;CPU based scale-out&#xa;Pod disruption budgets&#xa;Auto recovery by controllers&#xa;Rolling deployment strategy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B778C;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="470" y="690" width="520" height="95" as="geometry"/></mxCell>
        <mxCell id="prom" value="Prometheus&#xa;Scrapes /actuator/prometheus&#xa;Alerting rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FCFF;strokeColor=#00A3BF;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1260" y="260" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="graf" value="Grafana&#xa;SRE dashboard&#xa;TPS, totals, queue depth&#xa;retry/error/deadlock panels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FCFF;strokeColor=#00A3BF;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1260" y="430" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="jaeger" value="Jaeger&#xa;Trace search&#xa;correlationId + traceId&#xa;publish-to-consume latency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FCFF;strokeColor=#00A3BF;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1260" y="610" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="e1" value="ClusterIP MQ" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#FFAB00;" edge="1" parent="1" source="deploy1" target="sts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="consume" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#00875A;" edge="1" parent="1" source="sts" target="deploy2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="envFrom" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6554C0;" edge="1" parent="1" source="cfg" target="deploy1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="IRSA" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#DE350B;" edge="1" parent="1" source="sa" target="deploy2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="scrape" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#00A3BF;" edge="1" parent="1" source="prom" target="deploy2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="datasource" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#00A3BF;" edge="1" parent="1" source="graf" target="prom"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="OTLP traces" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#00A3BF;" edge="1" parent="1" source="deploy1" target="jaeger"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="security-model" name="05 Security Model">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Security Model - Identity, Secrets, Network and Runtime Controls" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1150" height="40" as="geometry"/></mxCell>
        <mxCell id="github" value="GitHub Actions&#xa;OIDC federation&#xa;No long-lived AWS keys in repo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#253858;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="deployrole" value="IAM Role&#xa;recon-github-actions-deploy-role&#xa;ECR push&#xa;EKS update kubeconfig&#xa;kubectl apply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#FF9900;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="390" y="180" width="260" height="145" as="geometry"/></mxCell>
        <mxCell id="eks" value="EKS OIDC Provider&#xa;IRSA trust boundary&#xa;Service account scoped to namespace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#00875A;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="730" y="180" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="approle" value="IAM Role&#xa;recon-platform-secrets-role&#xa;Allowed: secretsmanager:GetSecretValue&#xa;Resource: recon/prod/app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#DE350B;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1070" y="180" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="secrets" value="AWS Secrets Manager&#xa;DB_URL / DB_USER / DB_PASSWORD&#xa;MQ_USER / MQ_PASSWORD&#xa;Runtime loaded by app startup" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFEBE6;strokeColor=#DE350B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1450" y="165" width="250" height="160" as="geometry"/></mxCell>
        <mxCell id="net" value="Network Controls&#xa;RDS private subnets&#xa;RDS SG allows 5432 only from EKS cluster SG&#xa;NetworkPolicy limits app traffic&#xa;Dashboard exposed through LoadBalancer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#5B8DEF;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="450" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="runtime" value="Container Runtime Controls&#xa;runAsNonRoot&#xa;drop Linux capabilities&#xa;resource requests and limits&#xa;liveness/readiness probes&#xa;no hardcoded credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#97A0AF;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="510" y="450" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="mqsec" value="IBM MQ Security&#xa;CHLAUTH / SVRCONN channel&#xa;OAM queue manager authorities&#xa;Queue-level PUT/GET/BROWSE/INQ&#xa;MQRC 2035 handling runbook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FFAB00;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="950" y="450" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="audit" value="Audit and Evidence&#xa;Structured logs include event, transactionId, correlationId&#xa;Jaeger traceId follows producer to consumer&#xa;Prometheus counters provide replayable proof&#xa;GitHub commits and manifests auditable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FCFF;strokeColor=#00A3BF;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1390" y="450" width="310" height="160" as="geometry"/></mxCell>
        <mxCell id="e1" value="assume role with OIDC" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#253858;" edge="1" parent="1" source="github" target="deployrole"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="apply manifests" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#00875A;" edge="1" parent="1" source="deployrole" target="eks"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="web identity" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#DE350B;" edge="1" parent="1" source="eks" target="approle"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="GetSecretValue" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#DE350B;" edge="1" parent="1" source="approle" target="secrets"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="enforces" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#5B8DEF;" edge="1" parent="1" source="net" target="runtime"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="authorizes MQ access" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#FFAB00;" edge="1" parent="1" source="runtime" target="mqsec"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="evidence" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#00A3BF;" edge="1" parent="1" source="mqsec" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="observability-sre" name="06 Observability SRE">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Observability and SRE Architecture - Metrics, Logs, Traces, Alerts" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1050" height="40" as="geometry"/></mxCell>
        <mxCell id="apps" value="Application Telemetry Sources&#xa;Producer: published count, TPS, backpressure, queue-depth checks&#xa;Consumer: consumed count, retries, backout, deadlock retries, errors&#xa;Dashboard: HTTP metrics and health&#xa;IBM MQ: queue depth metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#97A0AF;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="380" height="170" as="geometry"/></mxCell>
        <mxCell id="otel" value="OpenTelemetry&#xa;W3C traceparent propagation&#xa;traceId + correlationId in message headers&#xa;Span: mq publish&#xa;Span: mq consume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#0747A6;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="170" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="prom" value="Prometheus&#xa;Scrapes /actuator/prometheus&#xa;Rules: high error rate, deadlock retry spike, queue depth backlog&#xa;Stores time-series evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FCFF;strokeColor=#00A3BF;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="940" y="165" width="330" height="160" as="geometry"/></mxCell>
        <mxCell id="graf" value="Grafana SRE Dashboard&#xa;Producer TPS&#xa;Consumer TPS&#xa;Total messages published&#xa;Total messages processed&#xa;MQ depth, retry/backout, errors, p95 latency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FCFF;strokeColor=#00A3BF;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1370" y="150" width="320" height="190" as="geometry"/></mxCell>
        <mxCell id="jaeger" value="Jaeger&#xa;Trace lookup by traceId&#xa;Shows producer publish span to consumer processing span&#xa;Used for correlation tracing evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="470" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="logs" value="Structured Logs&#xa;event=transaction_published&#xa;event=transaction_consumed&#xa;event=message_moved_to_retry&#xa;event=mq_authorization_failed mqrc=2035&#xa;transactionId / correlationId included" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#FF9900;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="460" width="380" height="170" as="geometry"/></mxCell>
        <mxCell id="alerts" value="Alerts and SLO Signals&#xa;Queue backlog growth&#xa;Consumer error-rate threshold&#xa;Deadlock retry spike&#xa;Application availability drop&#xa;Dashboard endpoint health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#DE350B;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="940" y="470" width="330" height="155" as="geometry"/></mxCell>
        <mxCell id="analysis" value="Failure Analysis Workflow&#xa;1. Alert fires in Prometheus/Grafana&#xa;2. Inspect queue depth and TPS panels&#xa;3. Search logs by correlationId&#xa;4. Open Jaeger trace for cross-service path&#xa;5. Replay from dashboard if message is recoverable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#00875A;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1370" y="455" width="320" height="190" as="geometry"/></mxCell>
        <mxCell id="e1" value="metrics" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#00A3BF;" edge="1" parent="1" source="apps" target="prom"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="dashboards" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#00A3BF;" edge="1" parent="1" source="prom" target="graf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="trace export" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6554C0;" edge="1" parent="1" source="otel" target="jaeger"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="structured events" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#FF9900;" edge="1" parent="1" source="apps" target="logs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="alert rules" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#DE350B;" edge="1" parent="1" source="prom" target="alerts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="triage" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#00875A;" edge="1" parent="1" source="alerts" target="analysis"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ha-dr-scaling" name="07 HA DR Scaling">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="High Availability, Disaster Recovery, Capacity and Cost Strategy" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1050" height="40" as="geometry"/></mxCell>
        <mxCell id="az1" value="Availability Zone A&#xa;EKS worker node&#xa;Producer / Consumer / Dashboard pods&#xa;IBM MQ pod and EBS volume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#00875A;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="90" y="165" width="310" height="160" as="geometry"/></mxCell>
        <mxCell id="az2" value="Availability Zone B&#xa;EKS worker node&#xa;Pods rescheduled on failure&#xa;HPA target capacity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#00875A;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="480" y="165" width="310" height="160" as="geometry"/></mxCell>
        <mxCell id="rds" value="RDS PostgreSQL&#xa;Recommended production: Multi-AZ&#xa;Automated backups + PITR&#xa;Private subnets&#xa;Read replica optional for dashboard analytics" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#EAE6FF;strokeColor=#6554C0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="870" y="150" width="310" height="180" as="geometry"/></mxCell>
        <mxCell id="mqha" value="IBM MQ HA Position&#xa;Assessment deployment: single StatefulSet for cost control&#xa;Production option: native HA/replicated data queue manager&#xa;Backups of MQ data PVC and MQSC topology" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FFAB00;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1260" y="150" width="350" height="180" as="geometry"/></mxCell>
        <mxCell id="scale" value="Scaling Strategy&#xa;Producer TPS controlled by config&#xa;Consumer concurrency controls throughput&#xa;HPA scales pods on CPU&#xa;Queue depth drives operational scale decisions&#xa;Backpressure prevents unbounded MQ growth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#0747A6;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="90" y="460" width="350" height="170" as="geometry"/></mxCell>
        <mxCell id="capacity" value="Capacity Planning&#xa;Required consumer TPS >= producer TPS&#xa;Measure p95 DB write latency&#xa;Monitor RECON.IN depth slope&#xa;Tune JMS concurrency, DB pool, RDS class&#xa;Use load tests before raising TPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#97A0AF;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="520" y="460" width="350" height="170" as="geometry"/></mxCell>
        <mxCell id="dr" value="DR Strategy&#xa;Infrastructure as code can recreate cluster&#xa;RDS backup restore to target region/account&#xa;ECR images versioned&#xa;Secrets Manager backup/export process&#xa;MQ topology recreated from MQSC scripts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#DE350B;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="950" y="460" width="350" height="170" as="geometry"/></mxCell>
        <mxCell id="cost" value="Cost Optimization&#xa;Free-tier eligible/small nodes for assessment&#xa;Scale workloads to zero when idle&#xa;Right-size RDS and EKS nodes after metrics&#xa;Retain only required logs/metrics duration&#xa;Use raw manifests now, Helm/Terraform for repeatability later" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#FF9900;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1380" y="460" width="310" height="170" as="geometry"/></mxCell>
        <mxCell id="tradeoffs" value="Key trade-offs&#xa;IBM MQ StatefulSet is simpler for assessment but production HA needs replicated queue manager or managed MQ pattern.&#xa;Dashboard LoadBalancer accelerates demo access but production should front it with authenticated ingress/WAF/TLS.&#xa;Prometheus/Grafana in-cluster is portable and demonstrable; managed observability reduces operations in production." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B778C;fontSize=14;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="90" y="735" width="1600" height="105" as="geometry"/></mxCell>
        <mxCell id="e1" value="pod reschedule" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#00875A;" edge="1" parent="1" source="az1" target="az2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="DB HA / backup" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6554C0;" edge="1" parent="1" source="az2" target="rds"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="durable messages" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#FFAB00;" edge="1" parent="1" source="az1" target="mqha"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="tune" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0747A6;" edge="1" parent="1" source="scale" target="capacity"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="restore plan" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#DE350B;" edge="1" parent="1" source="capacity" target="dr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="right-size" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#FF9900;" edge="1" parent="1" source="dr" target="cost"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
