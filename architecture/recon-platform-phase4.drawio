        <mxCell id="c2" value="5. Reconciliation Domain Logic&#xa;Business validation&#xa;Idempotency lookup&#xa;Duplicate detection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#00875A;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1230" y="230" width="250" height="125" as="geometry"/></mxCell>
